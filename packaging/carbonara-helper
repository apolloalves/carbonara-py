def main() -> int:
    from core.i18n import tr
    # Recebe DISPLAY/XAUTHORITY como argumentos posicionais (não via `env`
    # na linha de comando) — isso é essencial: se o pkexec vir "env" como
    # o programa a ser executado, ele não bate com o exec.path da política
    # customizada (que aponta pro carbonara-helper), e cai de volta na
    # ação genérica do sistema (a caixa feia mostrando o comando cru).
    if len(sys.argv) < 4:
        print(
            "Uso: carbonara-helper <DISPLAY> <XAUTHORITY> <ação> ['<json>']",
            file=sys.stderr,
        )
        return 2

    display, xauthority, action = sys.argv[1], sys.argv[2], sys.argv[3]
    raw_args = sys.argv[4] if len(sys.argv) > 4 else "{}"

    if display:
        os.environ["DISPLAY"] = display
    if xauthority:
        os.environ["XAUTHORITY"] = xauthority

    try:
        args = json.loads(raw_args)
    except json.JSONDecodeError as exc:
        print(tr("helper.invalid_json_args").format(exc=exc), file=sys.stderr)
        return 2

    handler = ACTIONS.get(action)
    if handler is None:
        print(tr("helper.unknown_action").format(action=action), file=sys.stderr)
        return 2

    handler(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
