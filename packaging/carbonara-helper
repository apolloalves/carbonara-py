def _run_eggs_action(args: dict) -> None:
    from PySide6.QtWidgets import QApplication
    from core.eggs import eggs as eggs_module
    from ui.widgets.eggs_progress import EggsProgressDialog
    from core.i18n import tr
    import traceback

    func = getattr(eggs_module, args["func_name"])
    app = QApplication([])
    dialog = EggsProgressDialog(
        args["title"],
        preparing_text=args.get("preparing_text"),
        icon_glyph=args.get("icon_glyph", "mdi6.egg-outline"),
    )
    # Repassa kwargs extras conhecidos (ex: "destination", escolhido no
    # combo da UI) — antes disso, o valor chegava até aqui mas nunca era
    # encaminhado pra função de verdade, então era sempre ignorado.
    extra_kwargs = {}
    if "destination" in args:
        extra_kwargs["destination"] = args["destination"]
    if "update_check_version" in args:
        extra_kwargs["update_check_version"] = args["update_check_version"]

    try:
        func(dialog, **extra_kwargs)
    except Exception as exc:
        # Bug interno inesperado (não é uma falha "esperada" de operação,
        # tipo espaço insuficiente — essas já se tratam sozinhas) — em vez
        # de deixar subir cru e virar uma janela de traceback separada na
        # cara do usuário, mostra como uma falha normal dentro do próprio
        # diálogo (que já está aberto). O traceback completo ainda vai
        # pro log técnico (rolável, quem quiser investigar encontra), só
        # não é mais a PRIMEIRA coisa que aparece.
        dialog.append_log(f"✗ {tr('helper.unexpected_error')}: {exc}")
        dialog.append_log(traceback.format_exc())
        dialog.set_status(tr("eggs_core.status_op_failed"))
        dialog.progress.setRange(0, 100)
        dialog.progress.setValue(0)
        dialog._had_failure = True
        dialog.set_running(False)

    # Se o usuário já fechou a janela pelo X durante o painel de disco
    # alternativo (dentro de check_space(), chamado por create_eggs/
    # install_eggs/etc — ver prompt_alternative_destination), o log já
    # registrou isso. Não reabre a mesma janela numa tela final pedindo
    # mais um clique em "Fechar": ele já disse que queria fechar. Mesmo
    # fix já aplicado em _run_backup_create/_run_single_create_and_exit.
    if getattr(dialog, "_user_requested_close", False):
        return

    dialog.exec()


