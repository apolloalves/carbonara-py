def _run_eggs_force_kill(args: dict) -> None:
    """Mata qualquer processo travado do Penguin's Eggs (xorriso, eggs
    produce) — existe porque a janela de progresso roda DENTRO do
    processo privilegiado (root, via pkexec). Quando trava, o "Force
    Quit" do GNOME é disparado pela sessão do usuário normal, que não
    tem permissão pra matar um processo do root — a janela fecha
    visualmente mas o processo (e o xorriso filho) continua vivo,
    escondido, travando a UI pra sempre. Isso dá um jeito de matar via
    root de verdade, sem precisar reiniciar o Carbonara."""
    for pattern in ("xorriso", "eggs produce", "eggs calamares", "mksquashfs"):
        subprocess.run(["pkill", "-9", "-f", pattern], capture_output=True)
    print("Processos travados do Penguin's Eggs encerrados (se existiam).")


