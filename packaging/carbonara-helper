def _run_scheduler_install(args: dict) -> None:
    """Escreve/atualiza carbonara-sync.service + carbonara-sync.timer e
    ativa (ou desativa, se enabled=False) o timer. Chamado toda vez que
    o usuário clica em "Salvar agendamento" na tela do Timeshift — a
    config chega inteira via args["config"] (o mesmo dict que a UI
    também grava em ~/.config/carbonara/schedule.json)."""
    import subprocess
    from core.snapshots.scheduler import build_oncalendar

    config = args["config"]

    SERVICE_PATH = Path("/etc/systemd/system/carbonara-sync.service")
    TIMER_PATH = Path("/etc/systemd/system/carbonara-sync.timer")

    service_content = (
        "[Unit]\n"
        "Description=Carbonara - sincronizacao automatica de snapshots\n"
        "After=local-fs.target\n"
        "\n"
        "[Service]\n"
        "Type=oneshot\n"
        "User=root\n"
        f"Environment=HOME=/home/{CARBONARA_USER}\n"
        f"WorkingDirectory={PROJECT_ROOT}\n"
        f"ExecStart={VENV_PYTHON} -m core.snapshots.scheduler\n"
    )
    SERVICE_PATH.write_text(service_content, encoding="utf-8")
    SERVICE_PATH.chmod(0o644)

    if config.get("enabled"):
        oncalendar = build_oncalendar(config)
        timer_content = (
            "[Unit]\n"
            "Description=Carbonara - timer da sincronizacao automatica\n"
            "\n"
            "[Timer]\n"
            f"OnCalendar={oncalendar}\n"
            "Persistent=true\n"
            "\n"
            "[Install]\n"
            "WantedBy=timers.target\n"
        )
        TIMER_PATH.write_text(timer_content, encoding="utf-8")
        TIMER_PATH.chmod(0o644)

        subprocess.run(["systemctl", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "enable", "--now", "carbonara-sync.timer"], check=True)
        print(f"Timer instalado e ativado: OnCalendar={oncalendar}")
    else:
        # desativado -> desliga e remove só o .timer; o .service pode
        # ficar (nunca é disparado sem o timer apontando pra ele)
        subprocess.run(["systemctl", "disable", "--now", "carbonara-sync.timer"], check=False)
        if TIMER_PATH.exists():
            TIMER_PATH.unlink()
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        print("Timer desativado e removido.")


def _run_scheduler_uninstall(args: dict) -> None:
    """Remove COMPLETAMENTE os units (.timer e .service) — diferente de
    salvar com enabled=False, que só desliga o timer e mantém o .service.
    Não usado no fluxo normal do botão "Salvar agendamento"; existe pra
    um eventual botão de "remover agendamento" por completo, se vier a
    ser necessário."""
    import subprocess

    subprocess.run(["systemctl", "disable", "--now", "carbonara-sync.timer"], check=False)
    for p in (
        Path("/etc/systemd/system/carbonara-sync.timer"),
        Path("/etc/systemd/system/carbonara-sync.service"),
    ):
        if p.exists():
            p.unlink()
    subprocess.run(["systemctl", "daemon-reload"], check=True)
    print("Agendamento removido do systemd.")


