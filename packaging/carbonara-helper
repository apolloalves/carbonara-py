def _run_eggs_copy_or_move_iso(args: dict, delete_source: bool) -> None:
    """Copia um .iso pra outro disco escolhido pelo usuário (via
    DiskPickerDialog) — e, se `delete_source`, apaga a origem depois de
    confirmar que a cópia terminou com sucesso, virando um "mover" de
    verdade (rsync não tem um modo nativo de mover entre dispositivos
    diferentes). Mesma convenção de pasta que o eggs.py já usa: MDSATA
    guarda em MDSATA/ARCHEGGS/, os demais discos direto na raiz do
    mountpoint.

    Janela de progresso de verdade — reaproveita o EggsProgressDialog e
    o RsyncWorker já usados em todo o resto do app (mesmo padrão de
    create_backup/create_eggs), em vez de rodar silencioso feito o
    delete (que é só um unlink instantâneo, não precisa de tela)."""
    from PySide6.QtWidgets import QApplication
    from ui.widgets.eggs_progress import EggsProgressDialog
    from core.workers.rsync_worker import RsyncWorker
    from core.i18n import tr

    src = Path(args["path"])
    if not src.exists():
        print(tr("helper.file_not_found").format(path=src), file=sys.stderr)
        sys.exit(1)

    destination_mountpoint = Path(args["destination_mountpoint"])
    if destination_mountpoint == Path("/mnt/MDSATA"):
        dest_dir = destination_mountpoint / "ARCHEGGS"
    else:
        dest_dir = destination_mountpoint
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest_path = dest_dir / src.name

    app = QApplication([])

    title_key = "eggs.moving_title" if delete_source else "eggs.copying_title"
    title = tr(title_key).format(name=src.name)
    icon_glyph = "mdi6.folder-move-outline" if delete_source else "mdi6.content-copy"
    # Cores diferentes pra não ficar tudo igual: mover usa a mesma cor
    # âmbar do ícone no menu "⋮" (eggs_page.py's act_move), copiar usa
    # azul — só essas duas telas, o resto (Create/Check/Install) segue
    # verde como sempre.
    header_color = "#c3a864" if delete_source else "#3b82f6"
    dialog = EggsProgressDialog(
        title, icon_glyph=icon_glyph, compact=True,
        header_color=header_color, needs_eggs_cleanup=False,
    )

    cmd = ["rsync", "-ahv", "--info=progress2", str(src), str(dest_path)]
    worker = RsyncWorker(cmd, title=title)

    register = getattr(dialog, "register_worker", None)
    if callable(register):
        dialog.register_worker(worker)
    else:
        dialog._worker = worker

    worker.progress_changed.connect(dialog.progress.setValue)
    worker.status_changed.connect(dialog.set_status)
    worker.log_line.connect(dialog.append_log)
    if hasattr(dialog, "set_current_file"):
        worker.file_changed.connect(dialog.set_current_file)

    def _on_ok() -> None:
        if delete_source:
            try:
                src.unlink()
            except OSError as exc:
                dialog.append_log(f"✗ {tr('helper.unexpected_error')}: {exc}")
        dialog.set_status(tr("eggs_core.status_op_done"))
        dialog.progress.setValue(100)
        dialog.set_running(False)

    def _on_failed(msg: str) -> None:
        dialog.append_log(f"✗ {msg}")
        dialog.set_status(tr("eggs_core.status_op_failed"))
        dialog._had_failure = True
        dialog.set_running(False)

    worker.finished_ok.connect(_on_ok)
    worker.failed.connect(_on_failed)

    dialog.set_running(True)
    worker.start()
    dialog.exec()


def _run_backup_create(args: dict) -> None:
    from PySide6.QtWidgets import QApplication
    from core.snapshots.backup import create_backup
    from core.snapshots.scheduler import check_space_for_create, load_create_schedule_config
