    "vfat": ("fsck.vfat", ["-v", "-r", "-f"]),
    "fat32": ("fsck.vfat", ["-v", "-r", "-f"]),
    "fat16": ("fsck.vfat", ["-v", "-r", "-f"]),
    "ext2": ("fsck.ext4", ["-f", "-y", "-v"]),
    "ext3": ("fsck.ext4", ["-f", "-y", "-v"]),
    "ext4": ("fsck.ext4", ["-f", "-y", "-v"]),
    "xfs": ("xfs_repair", []),
    "exfat": ("fsck.exfat", ["-v"]),
    "ntfs": ("ntfsfix", []),
}


def _run_doctor_fsck_repair(args: dict) -> None:
    """Correção de verdade por trás do achado "Integridade dos volumes"
    do Doctor Arch — o check em core/system/doctor.py só faz fsck -n
    (leitura, nunca corrige, nunca roda em montado). Este helper roda o
    fsck REAL, mas com exatamente a mesma seleção segura de dispositivos
    do FsckMonstro.sh: nunca em algo montado, nunca em RAID
    member/LUKS/swap/LVM. Btrfs fica de fora de propósito — 'btrfs check'
    sem --repair só diagnostica, e --repair é perigoso o bastante pra não
    automatizar sem revisão manual."""
    from core.i18n import tr
    result = subprocess.run(
        ["lsblk", "-J", "-o", "NAME,FSTYPE,MOUNTPOINT,TYPE"],
        capture_output=True, text=True, timeout=15,
    )
    try:
        tree = json.loads(result.stdout or "{}")
    except json.JSONDecodeError:
        tree = {}

    # lsblk -J aninha partições dentro do disco pai — achata tudo (disco +
    # partições) numa lista só, que é o que interessa aqui.
    def _flatten(nodes: list) -> list:
        flat = []
        for node in nodes:
            flat.append(node)
            flat.extend(_flatten(node.get("children", [])))
        return flat

    devices = _flatten(tree.get("blockdevices", []))

    results: dict[str, str] = {}
    seen_devs: set[str] = set()
    for dev_info in devices:
        dev = dev_info.get("name") or ""
        fstype = dev_info.get("fstype") or ""
        mountpoint = dev_info.get("mountpoint")
        if not dev.startswith("/"):
            dev = f"/dev/{dev}"

        # RAID com mais de um disco físico membro faz o lsblk duplicar a
        # árvore inteira do array (md127, md127p1, p2, p3...) embaixo de
        # CADA disco físico que alimenta ele — sem isso, "Pulando ..."
        # aparece repetido uma vez por disco membro, sem fazer mal nenhum
        # (não roda fsck duas vezes), só polui o log.
        if dev in seen_devs:
            continue
        seen_devs.add(dev)
        if not fstype:
            continue
        if fstype in _FSCK_SKIP_FSTYPES:
            continue
        if mountpoint:
            print(f"Pulando {dev} (montado em {mountpoint})", flush=True)
            continue

        tool_info = _FSCK_TOOL_BY_FSTYPE.get(fstype)
        if tool_info is None:
            print(f"Pulando {dev} (fstype={fstype} sem checador conhecido)", flush=True)
            continue
        tool, opts = tool_info

        if shutil.which(tool) is None:
            print(tr("helper.skipping_no_tool").format(dev=dev, tool=tool), flush=True)
            results[dev] = f"FERRAMENTA AUSENTE ({tool})"
            continue

        print(f"Executando: {tool} {' '.join(opts)} {dev}", flush=True)
        proc = subprocess.run(
            [tool, *opts, dev], capture_output=True, text=True, timeout=1800,
        )
        for out_line in (proc.stdout + proc.stderr).splitlines():
            print(f"  {out_line}", flush=True)

        if proc.returncode <= 1:
            results[dev] = f"OK ({fstype}, code={proc.returncode})"
        else:
            results[dev] = f"FALHOU ({fstype}, code={proc.returncode})"

    print("", flush=True)
    print("=== Resumo ===", flush=True)
    if not results:
        print(tr("helper.no_eligible_volume"), flush=True)
    for dev, status in results.items():
        print(f"{dev}: {status}", flush=True)


def _run_doctor_fix_empty_libs(args: dict) -> None:
    """Correção do achado "Bibliotecas .so vazias" — origem: FixArch.sh.
    Re-detecta (não confia no resultado do checkup, que pode estar
    desatualizado) e reinstala os pacotes donos via pacman -S --needed,
    que sobrescreve só os arquivos que já vêm no pacote — não apaga nada
    que não seja parte dele."""
    from core.i18n import tr
    result = subprocess.run(
        ["find", "/usr/lib", "-type", "f", "-size", "0", "-name", "*.so*"],
        capture_output=True, text=True, timeout=30,
    )
    empty_libs = [l for l in result.stdout.splitlines() if l.strip()]

    if not empty_libs:
        print("Nenhuma biblioteca .so vazia encontrada — nada a fazer.", flush=True)
        return

    print(f"Bibliotecas vazias encontradas ({len(empty_libs)}):", flush=True)
    for lib in empty_libs:
        print(f"  {lib}", flush=True)

    owner_result = subprocess.run(
        ["pacman", "-Qqo", *empty_libs],
        capture_output=True, text=True, timeout=30,
    )
    pkgs = sorted(set(l.strip() for l in owner_result.stdout.splitlines() if l.strip()))

    if not pkgs:
        print(tr("helper.no_owner_pkg_found"), flush=True)
        return

    print(f"Pacotes a reinstalar: {', '.join(pkgs)}", flush=True)
    proc = subprocess.run(
        ["pacman", "-S", "--needed", "--noconfirm", *pkgs],
        capture_output=True, text=True, timeout=600,
    )
    for line in (proc.stdout + proc.stderr).splitlines():
        print(f"  {line}", flush=True)

    if proc.returncode == 0:
        print(tr("helper.reinstall_done").format(pkgs=', '.join(pkgs)), flush=True)
    else:
        print(tr("helper.pacman_exit_code").format(code=proc.returncode), flush=True)


