def _run_restore_copy_files(args: dict) -> None:
    import shutil

    snapshot_root = Path(args["snapshot_root"])
    items = args["items"]
    conflict = args["conflict"]
    dest_prefix = args.get("dest_prefix", "")

    def to_dest(rel: Path) -> Path:
        if dest_prefix:
            return Path("/") / dest_prefix / rel
        return Path("/") / rel

    for src_str in items:
        src = Path(src_str)
        try:
            rel = src.relative_to(snapshot_root)
        except ValueError:
            continue
        dst = to_dest(rel)
        if src.is_dir():
            for f in src.rglob("*"):
                if f.is_file() or f.is_symlink():
                    try:
                        rel_f = f.relative_to(snapshot_root)
                        dst_f = to_dest(rel_f)
                        if dst_f.exists() and conflict == "skip":
                            print(f"SKIP: {dst_f}")
                            continue
                        dst_f.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(f, dst_f)
                        print(f"OK: {dst_f}")
                    except Exception as ex:
                        print(f"ERR: {dst_f} -- {ex}")
        else:
            try:
                if dst.exists() and conflict == "skip":
                    print(f"SKIP: {dst}")
                else:
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(src, dst)
                    print(f"OK: {dst}")
            except Exception as ex:
                print(f"ERR: {dst} -- {ex}")


def _run_restore_copy_to_alt_disk(args: dict) -> None:
    from PySide6.QtWidgets import QApplication
    from ui.widgets.backup_progress import BackupProgressDialog
    from core.workers.rsync_worker import RsyncWorker

    snap = Path(args["snap_path"])
    dest_base = Path(args["dest_path"]) / "CarbonaraSnapshots" / snap.parent.name
    dest_base.mkdir(parents=True, exist_ok=True)
    dest_dir = dest_base / snap.name

    cmd = [
        "rsync", "-aAXHh",
        "--numeric-ids",
        "--info=progress2",
        "--out-format=Copiando: %n",
    ]
    if args.get("use_delete"):
        cmd.append("--delete")
    if args.get("use_hardlinks"):
        cmd.append("-H")
    cmd += [str(snap) + "/", str(dest_dir) + "/"]

    app = QApplication([])
    from core.i18n import tr
    dialog = BackupProgressDialog(tr("backup.dialog_title_restore").format(dest=args['dest_label']))
    dialog.set_running(True)
    dialog.set_status(tr("backup.starting_restore"))
    dialog.progress.setRange(0, 100)
    dialog.progress.setValue(0)

    worker = RsyncWorker(cmd, title=tr("backup.copying_snapshot"), parent=dialog)
    dialog.register_worker(worker)
    worker.progress_changed.connect(dialog.progress.setValue)
    worker.status_changed.connect(dialog.set_status)
    worker.file_changed.connect(dialog.set_current_file)
    worker.log_line.connect(dialog.append_log)

    def on_ok():
        dialog.set_status(tr("backup.restore_done_ok"))
        dialog.progress.setValue(100)
        dialog.set_running(False)
        dialog.btn_close.setEnabled(True)

    def on_fail(msg):
        dialog.set_status(tr("backup.error_prefix").format(msg=msg))
        dialog.set_running(False)
        dialog.btn_close.setEnabled(True)

    worker.finished_ok.connect(on_ok)
    worker.failed.connect(on_fail)
    worker.start()
    dialog.exec()


def _run_delete_snapshot(args: dict) -> None:
    import shutil
    from core.snapshots.backup import _try_generate_restore_script

    target = Path(args["target"])
    link = Path(args["link"])
    new_latest = args.get("new_latest")

    shutil.rmtree(target)

    # Atualiza symlink latest
    if link.is_symlink() or link.exists():
        link.unlink()
    if new_latest:
        link.symlink_to(Path(new_latest).name)

    # Remove a pasta ROOT/HOME em si se ficou vazia — os.rmdir só funciona
    # se estiver realmente vazia (nunca apaga nada com conteúdo dentro),
    # então é seguro tentar sem checagem extra.
    kind_base = target.parent
    try:
        os.rmdir(kind_base)
    except OSError:
        pass  # ainda tem outros snapshots, ou não está vazia por outro motivo
    else:
        # kind_base (ROOT ou HOME) ficou vazia e foi removida — confere se
        # CarbonaraSnapshots inteira também ficou vazia (o outro kind já
        # não existe ou também está vazio) e remove ela também
        carbonara_snapshots_dir = kind_base.parent
        try:
            os.rmdir(carbonara_snapshots_dir)
        except OSError:
            pass  # ainda tem o outro kind (ROOT ou HOME) com conteúdo

    # Regenera (ou remove, se não sobrar ROOT) o carbonara-restore.sh —
    # mesmo processo usado após backup/sync, pra nunca deixar o script
    # apontando para um snapshot que acabou de ser apagado.
    snapshot_base = kind_base.parent
    destination_mountpoint = str(kind_base.parent.parent)
    _try_generate_restore_script(snapshot_base, destination_mountpoint)


def _run_doctor_cleanup(args: dict) -> None:
    from core.system.cleanup import RUNNERS

    categories = args.get("categories", [])
    for cat in categories:
        runner = RUNNERS.get(cat)
        if runner is None:
            continue
        try:
            msg = runner()
        except Exception as exc:
            msg = f"Erro: {exc}"
        print(f"{cat}: {msg}", flush=True)


def _run_doctor_fix_log_dirs(args: dict) -> None:
    from core.system.doctor import EXPECTED_LOG_DIRS_BY_PACKAGE, _is_installed
    from core.i18n import tr

    created = []
    for package, dirs in EXPECTED_LOG_DIRS_BY_PACKAGE.items():
        if not _is_installed(package):
            continue
        for d in dirs:
            path = Path(d)
            if not path.is_dir():
                path.mkdir(parents=True, exist_ok=True)
                created.append(d)
    print(tr("helper.dirs_created").format(created=created or tr("helper.none_placeholder")))


